<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:ash="https://github.com/lukegalea/ash_bpmn/ns"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   id="Definitions_policy_review_acknowledgement"
                   targetNamespace="https://ash-enterprise.example/bpmn">
  <!--
    Review the policies and acknowledge them (SOC 2 CC1.1, CC2.2 and CC5.3). Started by the pack's recipe when the year's policy review falls due:
    the subject is the compliance.review_due occurrence recorded in this organization.

    Each person acknowledges for themselves. The service task names a declared target
    (AshEnterprise.Signatures.Request.open_acknowledgements): it asks every active person in
    the organization to acknowledge the current version of every current policy, one request
    each, in the app, and a person already asked by this review over those versions is not
    asked again. Under the recipe's standing grant it runs as the recipe runner acting for the
    person who published the recipe, and nothing else; published plainly, the recipe is
    refused, because this step acts. Each person reads, consents and acknowledges on their own
    request; the event records the SHA-256 of every version shown. Reminders follow on the
    host's schedule (AshEnterprise.Signatures.ReminderWorker).

    The review task shows the administrator who has and has not acknowledged. Closing it
    records the administrator's decision about the review and nothing more: it acknowledges
    nothing for anyone, the people outstanding stay outstanding, and the controls are judged
    from the acknowledgements themselves, not from this outcome.
    The reviewer is an Administrator other than the person whose write started the
    instance and the creator of the row that started it.
  -->
  <bpmn2:process id="Process_policy_review_acknowledgement" name="Review the policies and acknowledge them" isExecutable="true">

    <bpmn2:startEvent id="Start" name="Policy review due">
      <bpmn2:outgoing>Flow_to_ask</bpmn2:outgoing>
    </bpmn2:startEvent>

    <bpmn2:serviceTask id="Ask" name="Ask each person to acknowledge the current policies">
      <bpmn2:extensionElements>
        <ash:taskConfig action="policy_acknowledgements_open"/>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_to_ask</bpmn2:incoming>
      <bpmn2:outgoing>Flow_to_review</bpmn2:outgoing>
    </bpmn2:serviceTask>

    <bpmn2:userTask id="Review" name="Review the policies and who has acknowledged them">
      <bpmn2:extensionElements>
        <ash:taskConfig>
          <ash:candidates>
            <ash:candidate kind="role" of="Administrator"/>
          </ash:candidates>
          <ash:exclusions>
            <ash:exclusion who="instance.started_by_id"/>
            <ash:exclusion who="subject.created_by_id"/>
          </ash:exclusions>
          <ash:outcomes>
            <ash:outcome name="completed"/>
            <ash:outcome name="not_completed"/>
          </ash:outcomes>
        </ash:taskConfig>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_to_review</bpmn2:incoming>
      <bpmn2:outgoing>Flow_to_route</bpmn2:outgoing>
    </bpmn2:userTask>

    <bpmn2:exclusiveGateway id="Route" name="Completed?" default="Flow_not_completed">
      <bpmn2:incoming>Flow_to_route</bpmn2:incoming>
      <bpmn2:outgoing>Flow_completed</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_not_completed</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>

    <bpmn2:endEvent id="EndCompleted" name="Completed">
      <bpmn2:extensionElements><ash:taskConfig outcome="completed"/></bpmn2:extensionElements>
      <bpmn2:incoming>Flow_completed</bpmn2:incoming>
    </bpmn2:endEvent>

    <bpmn2:endEvent id="EndNotCompleted" name="Not completed">
      <bpmn2:extensionElements><ash:taskConfig outcome="not_completed"/></bpmn2:extensionElements>
      <bpmn2:incoming>Flow_not_completed</bpmn2:incoming>
    </bpmn2:endEvent>

    <bpmn2:sequenceFlow id="Flow_to_ask" sourceRef="Start" targetRef="Ask"/>
    <bpmn2:sequenceFlow id="Flow_to_review" sourceRef="Ask" targetRef="Review"/>
    <bpmn2:sequenceFlow id="Flow_to_route" sourceRef="Review" targetRef="Route"/>
    <bpmn2:sequenceFlow id="Flow_completed" sourceRef="Route" targetRef="EndCompleted">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression"
        language="feel">task.outcome = "completed"</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_not_completed" sourceRef="Route" targetRef="EndNotCompleted"/>
  </bpmn2:process>

  <bpmndi:BPMNDiagram id="Diagram_policy_review_acknowledgement">
    <bpmndi:BPMNPlane id="Plane_policy_review_acknowledgement" bpmnElement="Process_policy_review_acknowledgement">
      <bpmndi:BPMNShape id="Shape_Start" bpmnElement="Start">
        <dc:Bounds x="150" y="202" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Ask" bpmnElement="Ask">
        <dc:Bounds x="240" y="180" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Review" bpmnElement="Review">
        <dc:Bounds x="430" y="180" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Route" bpmnElement="Route" isMarkerVisible="true">
        <dc:Bounds x="630" y="195" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndCompleted" bpmnElement="EndCompleted">
        <dc:Bounds x="750" y="132" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndNotCompleted" bpmnElement="EndNotCompleted">
        <dc:Bounds x="750" y="272" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_to_ask" bpmnElement="Flow_to_ask">
        <di:waypoint x="186" y="220"/>
        <di:waypoint x="240" y="220"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_to_review" bpmnElement="Flow_to_review">
        <di:waypoint x="380" y="220"/>
        <di:waypoint x="430" y="220"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_to_route" bpmnElement="Flow_to_route">
        <di:waypoint x="570" y="220"/>
        <di:waypoint x="630" y="220"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_completed" bpmnElement="Flow_completed">
        <di:waypoint x="655" y="195"/>
        <di:waypoint x="655" y="150"/>
        <di:waypoint x="750" y="150"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_not_completed" bpmnElement="Flow_not_completed">
        <di:waypoint x="655" y="245"/>
        <di:waypoint x="655" y="290"/>
        <di:waypoint x="750" y="290"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn2:definitions>
